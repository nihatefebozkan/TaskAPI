    <PackageReference Include="Scalar.AspNetCore" Version="2.17.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TaskAPI.Infrastructure\TaskAPI.Infrastructure.csproj" />
    <ProjectReference Include="..\TaskAPI.Service\TaskAPI.Service.csproj" />
  </ItemGroup>

