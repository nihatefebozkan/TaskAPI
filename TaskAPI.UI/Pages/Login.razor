@page "/login"
@using System.Net
@using System.Net.Http.Json
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Giriş yap · TaskAPI</PageTitle>

<div class="wrap auth">
    <div class="auth-card">
        <a href="/" class="brand"><span class="mark" aria-hidden="true">{ }</span>TaskAPI</a>

        <h1>Giriş yap</h1>
        <p class="sub">Planına kaldığın yerden devam et.</p>

        <form class="auth-form" @onsubmit="Submit" @onsubmit:preventDefault>
            <label class="field" for="login-username">
                Kullanıcı adı
                <input type="text" id="login-username" autocomplete="username" spellcheck="false"
                       required maxlength="100" @bind="username" />
            </label>

            <label class="field" for="login-password">
                Şifre
                <span class="pw">
                    <input type="@(showPassword ? "text" : "password")" id="login-password"
                           autocomplete="current-password" required @bind="password" />
                    <button type="button" aria-pressed="@(showPassword ? "true" : "false")"
                            @onclick="() => showPassword = !showPassword">
                        @(showPassword ? "Gizle" : "Göster")
                    </button>
                </span>
            </label>

            @if (errorMessage is not null)
            {
                <p class="err" role="alert">@errorMessage</p>
            }

            @if (successMessage is not null)
            {
                <p role="status">@successMessage</p>
            }

            <button type="submit" class="btn" disabled="@isLoading">
                @(isLoading ? "Giriş yapılıyor…" : "Giriş yap")
            </button>
        </form>

        <p class="switch">Hesabın yok mu? <a href="register">Kayıt ol</a></p>
        <p class="session-note">Sayfayı yenilediğinde güvenliğin için tekrar giriş yapman gerekir.</p>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private bool showPassword;
    private string? errorMessage;
    private string? successMessage;
    private bool isLoading;

    [SupplyParameterFromQuery(Name = "registered")]
    public bool Registered { get; set; }

    [SupplyParameterFromQuery(Name = "logout")]
    public string? LogoutStatus { get; set; }

    protected override void OnInitialized()
    {
        if (Api.IsSignedIn)
            Navigation.NavigateTo("/home", replace: true);
    }

    protected override void OnParametersSet()
    {
        successMessage = Registered ? "Hesabın oluşturuldu. Şimdi giriş yapabilirsin." : null;
        if (LogoutStatus == "offline")
            errorMessage = "Bu cihazdan çıkış yapıldı. Sunucuya ulaşılamadığı için oturum iptali doğrulanamadı.";
        else if (LogoutStatus == "expired")
            errorMessage = "Oturumun sona erdi. Lütfen tekrar giriş yap.";
        else if (LogoutStatus == "done")
            successMessage = "Çıkış yapıldı.";
    }

    private async Task Submit()
    {
        if (isLoading)
            return;

        errorMessage = null;
        successMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Kullanıcı adı ve şifre boş olamaz.";
            return;
        }

        isLoading = true;
        try
        {
            await Api.Login(username.Trim(), password);
            password = "";
            Navigation.NavigateTo("/home", replace: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or System.Text.Json.JsonException or OperationCanceledException)
        {
            errorMessage = exception is HttpRequestException request && request.StatusCode is not null
                ? request.Message : "Giriş tamamlanamadı. Bağlantını kontrol edip tekrar dene.";
            password = "";
        }
        finally
        {
            isLoading = false;
        }
    }
}
