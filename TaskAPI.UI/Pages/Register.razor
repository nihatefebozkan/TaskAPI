@page "/register"
@using System.Net
@using System.Net.Http.Json
@inject ApiClient Api
@inject NavigationManager Navigation

<PageTitle>Kayıt ol · TaskAPI</PageTitle>

<div class="wrap auth">
    <div class="auth-card">
        <a href="/" class="brand"><span class="mark" aria-hidden="true">{ }</span>TaskAPI</a>

        <h1>Hesap oluştur</h1>
        <p class="sub">Bir kullanıcı adı ve şifre seç, hemen başla.</p>

        <form class="auth-form" @onsubmit="Submit" @onsubmit:preventDefault>
            <label class="field" for="register-username">
                Kullanıcı adı
                <input type="text" id="register-username" autocomplete="username" spellcheck="false"
                       required maxlength="100" @bind="username" />
            </label>

            <label class="field" for="register-password">
                Şifre
                <span class="pw">
                    <input type="@(showPassword ? "text" : "password")" id="register-password"
                           autocomplete="new-password" required @bind="password" />
                    <button type="button" aria-pressed="@(showPassword ? "true" : "false")"
                            @onclick="() => showPassword = !showPassword">
                        @(showPassword ? "Gizle" : "Göster")
                    </button>
                </span>
            </label>

            <label class="field" for="register-confirm">
                Şifreyi tekrar yaz
                <input type="password" id="register-confirm" autocomplete="new-password" required @bind="confirmPassword" />
            </label>

            @if (errorMessage is not null)
            {
                <p class="err" role="alert">@errorMessage</p>
            }

            <button type="submit" class="btn" disabled="@isLoading">
                @(isLoading ? "Kaydediliyor…" : "Kayıt ol")
            </button>
        </form>

        <p class="switch">Zaten hesabın var mı? <a href="login">Giriş yap</a></p>
    </div>
</div>

@code {
    private string username = "";
    private string password = "";
    private string confirmPassword = "";
    private bool showPassword;
    private string? errorMessage;
    private bool isLoading;

    private async Task Submit()
    {
        if (isLoading)
            return;

        errorMessage = null;

        if (string.IsNullOrWhiteSpace(username) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = "Kullanıcı adı ve şifre boş olamaz.";
            return;
        }

        if (password != confirmPassword)
        {
            errorMessage = "Şifreler birbiriyle eşleşmiyor.";
            return;
        }

        isLoading = true;
        try
        {
            await Api.Register(username.Trim(), password);
            password = "";
            confirmPassword = "";
            Navigation.NavigateTo("/login?registered=true", replace: true);
        }
        catch (Exception exception) when (exception is HttpRequestException or InvalidOperationException or OperationCanceledException)
        {
            errorMessage = exception is HttpRequestException request && request.StatusCode is not null
                ? request.Message : "Kayıt tamamlanamadı. Bağlantını kontrol edip tekrar dene.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
